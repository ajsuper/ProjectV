# Ignore build artifacts. *.bin covers compiled shaders, which projv_compile_shaders writes
# beside their .sc/.frag sources.
*.o
*.a
*.bin

# Ignore generated files and folders
obj/
lib/
build*/
SceneTest/

# A brush's tuned parameter values, written beside the brush by the SceneEditor's Brush Lab. The .lua
# is the brush and belongs in version control; the sidecar is one user's dial settings and is rewritten
# every time a slider moves.
examples/60-scene-editor/brushes/*.params.json

# Allow example models
!examples/30-renderers/SponzaScene/**/*.bin
!examples/20-mesh-voxelizer/testScene/**/*.bin

# Ignore VS Code config files
.vscode/

# Ignore clangd cache
.cache/


# Ignore the large SanMiguel LOD bakes. These are MeshVoxelizer output (290 MiB - 4.7 GiB) and
# every one of them is past GitHub's 100 MiB per-file ceiling. Re-bake them from the source mesh.
examples/10-scene-previewer/scenes/SanMiguel-8192/
examples/10-scene-previewer/scenes/SanMiguel-16384/
examples/10-scene-previewer/scenes/SanMiguel-32768/

# Ignore RenderDoc captures
*.rdc
