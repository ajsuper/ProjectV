{
    "uniforms": [
        {"name": "windowRes", "type": "vec4"},
        {"name": "sunDir",    "type": "vec4"},
        {"name": "cameraPos", "type": "vec4"},
        {"name": "cameraDir", "type": "vec4"},
        {"name": "frameCount", "type": "vec4"},
        {"name": "texelSize", "type": "vec4"}
    ],
    "shaders": [
        {"shaderID": 1, "path": "./renderers/tree64/shaders/path_trace.bin"},
        {"shaderID": 2, "path": "./renderers/tree64/shaders/denoise_ao_gi.bin"},
        {"shaderID": 3, "path": "./renderers/tree64/shaders/accumulate.bin"},
        {"shaderID": 4, "path": "./renderers/tree64/shaders/post_and_display.bin"}
    ],
    "textures": [
        {"texID": 1, "name": "resourceTexture", "format": "RGBA8", "resX": 256, "resY": 256, "sizeMode": "fixed", "origin": "CPUBuffer"},
        {"texID": 2, "name": "globalIllumination", "format": "RGBA16_FLOAT", "sizeMode": "relative", "scale": 1.0, "origin": "CreateNew"},
        {"texID": 3, "name": "directIllumination", "format": "RGBA16_FLOAT", "sizeMode": "relative", "scale": 1.0, "origin": "CreateNew"},
        {"texID": 4, "name": "normal", "format": "RGBA8", "sizeMode": "relative", "scale": 1.0, "origin": "CreateNew", "readBack": true},
        {"texID": 5, "name": "albedo", "format": "RGBA8", "sizeMode": "relative", "scale": 1.0, "origin": "CreateNew"},
        {"texID": 6, "name": "accumulatedRender", "format": "RGBA16_FLOAT", "sizeMode": "relative", "scale": 1.0, "origin": "CreateNew"},

        {"texID": 7, "name": "pickBuffer", "format": "RGBA32_FLOAT", "sizeMode": "relative", "scale": 1.0, "origin": "CreateNew", "readBack": true}
    ],
    "framebuffers": [
        {"fboID": 1, "textureIDs": [2, 3, 4, 5, 7]},
        {"fboID": 2, "textureIDs": [6]}
    ]
}
