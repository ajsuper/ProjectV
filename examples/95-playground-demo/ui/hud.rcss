/* The playground's HUD, over the demos' shared base.rcss. Edit it while the game runs: it reloads. */

body.hud { width: 100%; height: 100%; pointer-events: none; }
/* Text shadows as a font effect, drawn with the glyphs: a filter on each would cost a layer and a blur. */
p, .row { font-effect: shadow(0dp 1dp #000000b0); }

.flash {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%;
    decorator: radial-gradient(circle farthest-corner, #ffffff00 45%, #ffffffb0);
}
.ring { position: absolute; border-radius: 9999dp; box-sizing: border-box; border: 2dp #9cff9cd9; background-color: #9cff9c14; }
.cross { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.cross div { position: absolute; display: block; background-color: #ffffffe6; box-shadow: #000000b0 0dp 0dp 3dp 0dp; }
.cross .across { left: 50%; top: 50%; width: 16dp; height: 2dp; margin-left: -8dp; margin-top: -1dp; }
.cross .down { left: 50%; top: 50%; width: 2dp; height: 16dp; margin-left: -1dp; margin-top: -8dp; }

.top { position: absolute; left: 0; top: 16dp; width: 100%; text-align: center; }
.top .chip { display: inline-block; font-size: 20dp; font-weight: bold; padding: 6dp 16dp; }

.players { position: absolute; left: 16dp; top: 16dp; width: 190dp; padding: 8dp 10dp; }
.row { padding: 3dp 8dp; border-radius: 6dp; font-size: 16dp; }
.row.me { background-color: #ffffff1f; }
.swatch { display: inline-block; width: 14dp; height: 14dp; border-radius: 3dp; margin-right: 10dp; vertical-align: middle; }

.help { position: absolute; right: 16dp; top: 16dp; width: 250dp; padding: 10dp 14dp; font-size: 15dp; color: #dbe3ec; }
.help p { margin: 2dp 0; }
.fps { position: absolute; right: 16dp; bottom: 16dp; font-size: 15dp; }

.banner {
    position: absolute; left: 0; top: 26%; width: 100%; text-align: center;
    font-size: 60dp; font-weight: bold;
    filter: drop-shadow(#000000c0 0dp 3dp 10dp);
    animation: 0.4s back-out 1 banner-in;
}
@keyframes banner-in { from { opacity: 0; transform: scale(0.8); } to { opacity: 1; transform: scale(1); } }

.bottom { position: absolute; left: 0; bottom: 16dp; width: 100%; text-align: center; }
.reset {
    width: 400dp; height: 12dp; margin: 0 auto 10dp auto;
    border-radius: 6dp; background-color: #00000080; border: 1dp #ff663380;
}
.reset .fill { height: 100%; border-radius: 6dp; background-color: #ff6633; }
.tool-name { font-size: 17dp; font-weight: bold; margin-bottom: 6dp; }
.tools { text-align: center; }
.tool {
    display: inline-block; position: relative; width: 44dp; height: 44dp; margin: 0 3dp;
    border-radius: 8dp; background-color: #0a0f15b3; border: 1dp #ffffff26;
}
.tool.held { border: 2dp #ffffffd9; }
.tool .ready {
    position: absolute; left: 0; bottom: 0; width: 100%;
    border-radius: 7dp; background-color: #ffffff14;
}
.tool .number { position: absolute; left: 0; top: 12dp; width: 100%; text-align: center; font-weight: bold; }
