<rml>
<head>
    <title>Menu</title>
    <link type="text/rcss" href="base.rcss"/>
    <style>
        /* Fades in and out on ui-shown (the engine sets it; open it with fadeOut). */
        body {
            width: 100%; height: 100%;
            opacity: 0; pointer-events: none;
            transition: opacity 0.3s quadratic-in-out;
        }
        body.ui-shown { opacity: 1; pointer-events: auto; }
        .shade {
            position: absolute; left: 0; top: 0; width: 100%; height: 100%;
            decorator: radial-gradient(circle farthest-corner, #00000033 20%, #000000a8);
        }
        .menu {
            position: absolute; left: 50%; top: 50%; width: 340dp; margin-left: -170dp; margin-top: -235dp;
            transform: translateY(6dp);
            backdrop-filter: blur(0dp) saturate(1);
            transition: transform backdrop-filter 0.4s cubic-out;
        }
        .ui-shown .menu { transform: translateY(0dp); backdrop-filter: blur(18dp) saturate(1.3); }
        .title { font-size: 15dp; color: #b9c4d0; margin-top: -8dp; margin-bottom: 14dp; }
        h2 { margin-top: 18dp; margin-bottom: 0; font-size: 17dp; color: #dbe3ec; }
        .value { float: right; color: #b9c4d0; font-size: 15dp; }
        #leave { margin-top: 20dp; }
    </style>
</head>
<!-- The demos' shared menu (docs/plans/ui.md, D23): Esc opens it. It does not pause a networked game.
     Model "menu": game (the title), sensitivity, invertY, showFps. Actions: resume, leave. -->
<body data-model="menu">
    <div class="shade"></div>
    <div class="panel menu">
        <h1>{{game}}</h1>
        <p class="title">The game goes on: it is the server's.</p>
        <button id="resume" class="primary" onclick="resume">Resume</button>

        <h2>Settings</h2>
        <label>Mouse sensitivity <span class="value">{{sensitivity | format(2)}}</span></label>
        <input id="sensitivity" type="range" class="range" min="0.2" max="3" step="0.05" data-value="sensitivity"/>
        <label><input id="invert" type="checkbox" class="checkbox" data-checked="invertY"/>Invert the mouse's up and down</label>
        <label><input id="fps" type="checkbox" class="checkbox" data-checked="showFps"/>Show the frame rate</label>

        <button id="leave" onclick="leave">Leave</button>
    </div>
</body>
</rml>
