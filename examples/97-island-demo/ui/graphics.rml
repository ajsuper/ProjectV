<rml>
<head>
    <title>Island: graphics</title>
    <link type="text/rcss" href="pixel.rcss"/>
    <style>
        body { width: 100%; height: 100%; opacity: 0; pointer-events: none; transition: opacity 0.15s linear-in-out; }
        body.ui-shown { opacity: 1; pointer-events: auto; }
        .shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #160f1e8c; }
        /* The board (pixel.rcss): this one 244 x 272. */
        .board { position: absolute; left: 50%; top: 50%; margin-left: -122dp; margin-top: -136dp; width: 244dp; height: 272dp;
                 decorator: image(../icons/board-graphics.pixel.tga); }
        h1 { text-align: center; margin-bottom: 4dp; }
        .setting { display: block; position: relative; height: 15dp; margin-bottom: 1dp; }
        .setting .label { position: absolute; left: 0; top: 3dp; color: #e9c98a; }
        .setting button { position: absolute; right: 0; top: 0; width: 104dp; margin: 0; }
        .setting button .bevel { padding: 1dp 4dp 2dp 4dp; }
        .setting.preset .label { color: #ffd23f; }
        .note { color: #e9c98a; text-align: center; margin-top: 3dp; }
        #back { margin-top: 4dp; }
    </style>
</head>
<!-- The island demo's graphics settings (docs/plans/restir-pt-performance.md, D9), on a wooden board as the
     menus (island-demo.md, D9): restir-pt's preset and each of its settings, a click cycling one. Model
     "graphics": rows (label, value, key, class), note. Actions: cycle <key>, back. -->
<body data-model="graphics">
    <div class="shade"></div>
    <div class="board">
        <h1>Graphics</h1>
        <div data-for="r : rows" data-attr-class="'setting ' + r[3]">
            <div class="label">{{r[0]}}</div>
            <button data-attr-onclick="'cycle ' + r[2]"><div class="bevel">{{r[1]}}</div></button>
        </div>
        <p class="note">{{note}}</p>
        <button id="back" class="primary" onclick="back"><div class="bevel">Back</div></button>
    </div>
</body>
</rml>
