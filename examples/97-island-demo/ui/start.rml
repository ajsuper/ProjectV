<rml>
<head>
    <title>Island: start</title>
    <link type="text/rcss" href="pixel.rcss"/>
    <style>
        body { width: 100%; height: 100%; }
        .start { position: absolute; left: 50%; top: 50%; width: 208dp; margin-left: -104dp; margin-top: -150dp; }
        h1 { font-size: 30dp; line-height: 32dp; text-align: center; margin-bottom: 4dp; font-effect: shadow(2dp 2dp #170d06); }

        /* The board (pixel.rcss): this one 208 x 264. */
        .board { width: 208dp; height: 264dp; decorator: image(../icons/board.pixel.tga); }
        .board h2 { margin-top: 4dp; margin-bottom: 2dp; }
        .worlds { max-height: 70dp; overflow-y: auto; margin-bottom: 2dp; }
        .world { margin-bottom: 2dp; border: 1dp #170d06; cursor: pointer; }
        .world .bevel { padding: 1dp 4dp 2dp 4dp; background-color: #5e3c22; border-color: #9a6a3e #33200f #33200f #9a6a3e; }
        .world:hover .bevel { background-color: #744c2c; border-color: #c08a52 #33200f #33200f #c08a52; }
        .world .meta { color: #d2b48a; }
        .row { display: block; margin-bottom: 2dp; }
        .row label { color: #e9c98a; }
        .status { color: #ff9a84; margin-top: 2dp; }
        #quit { position: absolute; left: 18dp; bottom: 14dp; width: 172dp; }

    </style>
</head>
<!-- The island demo's start screen (docs/plans/island-demo.md, D11): a wooden board with vines (D9). Model
     "start": worlds (rows: folder, name, seed, last played, time played), hasWorlds, newName, newSeed,
     status. Actions: play <folder>, new, quit. -->
<body data-model="start">
    <div class="start">
        <h1>ISLAND</h1>
        <div class="board">
            <h2 data-if="hasWorlds">Saved worlds</h2>
            <div class="worlds" data-if="hasWorlds">
                <div class="world" data-for="w : worlds" data-attr-onclick="'play ' + w[0]">
                    <div class="bevel">
                        <div class="name">{{w[1]}}</div>
                        <div class="meta">{{w[2]}} - {{w[3]}}</div>
                    </div>
                </div>
            </div>

            <h2>New world</h2>
            <div class="row"><label>Name</label><input type="text" class="text" data-value="newName"/></div>
            <div class="row"><label>Seed</label><input type="text" class="text" data-value="newSeed" placeholder="random"/></div>
            <button id="new" class="primary" onclick="new"><div class="bevel">Create world</div></button>
            <p class="status" data-if="status != ''">{{status}}</p>

            <button id="quit" onclick="quit"><div class="bevel">Quit</div></button>
        </div>
    </div>
</body>
</rml>
