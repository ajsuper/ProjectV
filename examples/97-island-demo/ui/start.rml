<rml>
<head>
    <title>Island: start</title>
    <link type="text/rcss" href="pixel.rcss"/>
    <style>
        body { width: 100%; height: 100%; }
        .start { position: absolute; left: 50%; top: 10%; width: 200dp; margin-left: -100dp; }
        h1 { font-size: 30dp; line-height: 32dp; text-align: center; font-effect: shadow(2dp 2dp #160f1e); }
        .tagline { text-align: center; color: #f6ecd2; margin-bottom: 8dp; }
        h2 { margin-top: 8dp; }
        .worlds { max-height: 120dp; overflow-y: auto; }
        .world { margin-bottom: 2dp; border: 1dp #160f1e; cursor: pointer; }
        .world .bevel { padding: 2dp 4dp 3dp 4dp; }
        .world:hover .bevel { background-color: #3a4573; border-color: #7d8fd0 #1a1f3c #1a1f3c #7d8fd0; }
        .world .meta { color: #a3abcf; }
        .row { display: block; margin-bottom: 3dp; }
        .row label { color: #a3abcf; margin-bottom: 1dp; }
        .status { color: #ff8a78; margin-top: 3dp; }
        #quit { margin-top: 8dp; }
        scrollbarvertical { width: 4dp; }
        scrollbarvertical slidertrack { background-color: #1a1f3c; }
        scrollbarvertical sliderbar { background-color: #5f70b0; }
    </style>
</head>
<!-- The island demo's start screen (docs/plans/island-demo.md, D11), in the island's pixel art (D9). Model
     "start": worlds (rows: folder, name, seed, last played, time played), hasWorlds, newName, newSeed,
     status. Actions: play <folder>, new, quit. -->
<body data-model="start">
    <div class="start">
        <h1>ISLAND</h1>
        <p class="tagline shadow">Break it, gather it, build with it.</p>
        <div class="frame"><div class="bevel panel">
            <h2 data-if="hasWorlds">Your worlds</h2>
            <div class="worlds" data-if="hasWorlds">
                <div class="world" data-for="w : worlds" data-attr-onclick="'play ' + w[0]">
                    <div class="bevel">
                        <div class="name">{{w[1]}}</div>
                        <div class="meta">{{w[2]}} - {{w[3]}} - {{w[4]}}</div>
                    </div>
                </div>
            </div>

            <h2>A new world</h2>
            <div class="row"><label>Name</label><input type="text" class="text" data-value="newName"/></div>
            <div class="row"><label>Seed (empty: random)</label><input type="text" class="text" data-value="newSeed"/></div>
            <button id="new" class="primary" onclick="new"><div class="bevel">Make it</div></button>
            <p class="status" data-if="status != ''">{{status}}</p>

            <button id="quit" onclick="quit"><div class="bevel">Quit</div></button>
        </div></div>
    </div>
</body>
</rml>
