<rml>
<head>
    <title>Island: loading</title>
    <link type="text/rcss" href="pixel.rcss"/>
    <style>
        body { width: 100%; height: 100%; }
        .shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #160f1e66; }
        /* The board (pixel.rcss): the menu's, 184 x 156. */
        .board { position: absolute; left: 50%; top: 50%; margin-left: -92dp; margin-top: -78dp; width: 184dp; height: 156dp;
                 decorator: image(../icons/board-pause.pixel.tga); padding-top: 34dp; }
        h1 { text-align: center; }
        .world { text-align: center; color: #e9c98a; margin-bottom: 10dp; }
        /* How far along: a groove in the wood, filling with moss. */
        .bar { position: relative; width: 144dp; height: 10dp; box-sizing: border-box; border-width: 1dp;
               border-color: #170d06 #9a6a3e #9a6a3e #170d06; background-color: #2c1a0d; }
        .fill { position: absolute; left: 0; top: 0; height: 8dp; background-color: #4a7a32; border-top: 1dp #92c464; box-sizing: border-box; }
        .detail { text-align: center; color: #e9c98a; margin-top: 5dp; }
    </style>
</head>
<!-- The island demo's loading screen (docs/plans/island-demo.md, D15): what is being done while a world is
     made or read on a worker thread. Model "loading": title, world, fill (the bar's width, "72dp" of 142),
     detail. No actions. -->
<body data-model="loading">
    <div class="shade"></div>
    <div class="board">
        <h1>{{title}}</h1>
        <p class="world">{{world}}</p>
        <div class="bar"><div class="fill" data-style-width="fill"></div></div>
        <p class="detail">{{detail}}</p>
    </div>
</body>
</rml>
