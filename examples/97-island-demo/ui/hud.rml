<rml>
<head>
    <title>Island: HUD</title>
    <link type="text/rcss" href="pixel.rcss"/>
    <style>
        body { width: 100%; height: 100%; pointer-events: none; }

        /* The compass: a plank (icons.h's hud-compass) with a strip of ticks and letters sliding with the view,
           one dp a degree, the heading under a caret at its middle. */
        .compass { position: absolute; left: 50%; top: 4dp; width: 125dp; margin-left: -63dp; }
        .strip { position: relative; width: 125dp; height: 16dp; decorator: image(../icons/hud-compass.pixel.tga); }
        .inside { position: absolute; left: 2dp; top: 2dp; width: 121dp; height: 12dp; overflow: hidden; }
        .mark { position: absolute; top: 0; width: 15dp; margin-left: -7dp; text-align: center; color: #e9c98a;
                font-effect: shadow(1dp 1dp #170d06); }
        .mark.off { display: none; }
        .mark.card { color: #f6e7c8; }
        .mark.north { color: #ff8a78; }
        .mark.tick .bar { position: absolute; left: 7dp; top: 4dp; width: 1dp; height: 3dp; background-color: #e9c98a; }
        .caret { position: absolute; left: 62dp; top: 16dp; width: 1dp; height: 2dp; background-color: #ffd23f; }
        .caret.wide { left: 61dp; top: 18dp; width: 3dp; height: 1dp; }
        .heading { position: absolute; left: 0; top: 19dp; width: 125dp; text-align: center; color: #ffd23f;
                   font-effect: shadow(1dp 1dp #170d06); }

        /* The crosshair: a plus, gold over something in reach. */
        .cross { position: absolute; left: 50%; top: 50%; background-color: #f6ecd2; }
        .cross.h { width: 5dp; height: 1dp; margin-left: -2dp; }
        .cross.v { width: 1dp; height: 5dp; margin-top: -2dp; }
        .cross.on { background-color: #ffd23f; }
        .cross.ring { width: 7dp; height: 7dp; margin-left: -3dp; margin-top: -3dp; background-color: transparent;
                      border: 1dp #160f1e; opacity: 0.45; }

        /* Chips -- what E would collect, and collecting's state: an oak button's look, moss when on. */
        .chip { display: inline-block; border: 1dp #170d06; }
        .chip .bevel { padding: 1dp 4dp 2dp 4dp; background-color: #7a4f2c; border-color: #c08a52 #3a2310 #3a2310 #c08a52;
                       color: #f6e7c8; font-effect: shadow(1dp 1dp #170d06); }
        .key { color: #ffd23f; }
        .prompt { position: absolute; left: 0; top: 50%; margin-top: 14dp; width: 100%; text-align: center; }

        /* The hotbar: a board (icons.h's hud-hotbar) of nine slots sunk into the wood, the tools then the
           materials, each with its icon and count; the one in hand framed in gold and raised. Its name over
           it a moment after it is picked. */
        .hotbar { position: absolute; left: 50%; bottom: 4dp; width: 246dp; height: 32dp; margin-left: -123dp;
                  box-sizing: border-box; padding: 4dp 5dp 4dp 6dp; decorator: image(../icons/hud-hotbar.pixel.tga); }
        .slot { display: inline-block; position: relative; width: 22dp; height: 22dp; margin-right: 2dp;
                border: 1dp #170d06; }
        .slot .bevel { width: 20dp; height: 20dp; border-color: #170d06 #9a6a3e #9a6a3e #170d06; background-color: #2c1a0d; }
        .slot img { position: absolute; left: 2dp; top: 2dp; width: 16dp; height: 16dp; }
        .slot.none img { opacity: 0.35; }
        .slot .count { position: absolute; right: 1dp; bottom: -1dp; color: #f6e7c8; font-effect: shadow(1dp 1dp #170d06); }
        .slot.sel { margin-top: -3dp; border-color: #ffd23f; }
        .slot.sel .bevel { border-color: #f3d9a0 #6b4320 #6b4320 #f3d9a0; background-color: #5e3c22; }
        .held { position: absolute; left: 0; bottom: 39dp; width: 100%; text-align: center; color: #ffd23f;
                font-effect: shadow(1dp 1dp #170d06); opacity: 0; transition: opacity 0.5s linear-in-out; }
        .held.shown { opacity: 1; transition: opacity 0.05s linear-in-out; }

        /* Collecting, at the hotbar's right. */
        .collect { position: absolute; left: 50%; bottom: 11dp; margin-left: 127dp; }
        .collect .state { color: #e9c98a; }
        .collect.on .bevel { background-color: #4a7a32; border-color: #92c464 #23401a #23401a #92c464; }
        .collect.on .state { color: #d4f7a8; }
    </style>
</head>
<!-- The island demo's HUD (docs/plans/island-demo.md, D9). Model "island": compass (rows: label, left,
     class), heading, slots (rows: icon, count, class: sel, none), held, heldShown, aiming, prompt,
     collecting. No actions: it takes no input. -->
<body data-model="island">
    <div class="compass">
        <div class="strip"><div class="inside">
            <div data-for="m : compass" data-attr-class="'mark ' + m[2]" data-style-left="m[1]">
                <div class="bar" data-if="m[0] == ''"></div>{{m[0]}}
            </div>
        </div></div>
        <div class="caret"></div>
        <div class="caret wide"></div>
        <div class="heading shadow">{{heading}}</div>
    </div>

    <div class="cross ring"></div>
    <div class="cross h" data-class-on="aiming"></div>
    <div class="cross v" data-class-on="aiming"></div>

    <div class="prompt" data-if="prompt != ''">
        <div class="chip"><div class="bevel"><span class="key">E</span> {{prompt}}</div></div>
    </div>

    <div class="held" data-class-shown="heldShown">{{held}}</div>
    <div class="hotbar">
        <div data-for="s : slots" data-attr-class="'slot ' + s[2]">
            <div class="bevel"></div>
            <img data-attr-src="s[0]"/>
            <div class="count">{{s[1]}}</div>
        </div>
    </div>
    <div class="collect chip" data-class-on="collecting">
        <div class="bevel"><span class="key">E</span> Collect <span class="state">{{collecting ? 'ON' : 'off'}}</span></div>
    </div>
</body>
</rml>
