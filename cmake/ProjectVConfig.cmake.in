@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Every one of these appears in ProjectV's public headers, so a consumer needs all of them
# on its include path whether it names them or not. Declaring them here is what lets a
# consumer write nothing but find_package(ProjectV CONFIG REQUIRED) and link
# ProjectV::projectV.
find_dependency(bgfx CONFIG)
find_dependency(glm CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(nlohmann_json CONFIG)
find_dependency(glfw3 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/ProjectVTargets.cmake")

# projv_compile_shaders(), so a consumer can build .sc/.frag shaders against the engine's
# shader library without reimplementing the shaderc invocation.
include("${CMAKE_CURRENT_LIST_DIR}/ProjectVShaders.cmake")

check_required_components(ProjectV)
