# Installed by ProjectV when it was built against its own copy of EnTT (external/entt), which has no
# install of its own. Recreates the EnTT::EnTT target that ProjectV's exported targets link to.
if(NOT TARGET EnTT::EnTT)
    get_filename_component(_projv_entt_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
    add_library(EnTT::EnTT INTERFACE IMPORTED)
    set_target_properties(EnTT::EnTT PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_projv_entt_prefix}/@CMAKE_INSTALL_INCLUDEDIR@/projv/third_party"
        INTERFACE_COMPILE_FEATURES cxx_std_20)
    unset(_projv_entt_prefix)
endif()
set(EnTT_FOUND TRUE)
