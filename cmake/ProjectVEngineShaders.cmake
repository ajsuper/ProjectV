# The engine's own shaders (shaders/engine/), compiled into the library rather than staged beside a
# program (docs/plans/shader-library.md, D3).
#
# Each shader is compiled once per profile with shaderc's --bin2c into a header in the build tree;
# one generated source holds the table that graphics::engineShader() looks a shader up in, by name
# and renderer type. Nothing is read from disk at run time, so a program cannot run with engine
# shaders that belong to another build of the engine.
#
#   projv_embed_engine_shaders(TARGET projectV SHADER_DIRS shaders/engine shaders/engine/imgui
#                              INCLUDE_DIR shaders/include)
#
# Same conventions as projv_compile_shaders: vs_*.sc are vertex shaders, *.frag fragment shaders,
# varying.def.sc beside them -- one per directory, which is why a shader with other varyings (ImGui's
# 2D vertices) has a directory of its own. A shader is named by its file's base name ("vs_quad"), so
# names are unique across the directories.
#
# PROJV_ENGINE_SHADER_PROFILES picks the profiles: the one the platform's renderer runs on by default
# (render_instance.cpp: Metal on Apple, Vulkan elsewhere). Add one for another backend; each profile
# is one more copy of every engine shader in the library.

if(APPLE)
    set(_projvDefaultEngineProfiles metal)
else()
    set(_projvDefaultEngineProfiles spirv)
endif()
set(PROJV_ENGINE_SHADER_PROFILES "${_projvDefaultEngineProfiles}" CACHE STRING
    "shaderc profiles the engine's embedded shaders are compiled for (spirv, metal)")

function(projv_embed_engine_shaders)
    cmake_parse_arguments(ARG "" "TARGET;INCLUDE_DIR" "SHADER_DIRS" ${ARGN})
    get_filename_component(includeDir "${ARG_INCLUDE_DIR}" ABSOLUTE)
    set(outDir "${CMAKE_CURRENT_BINARY_DIR}/generated/engine_shaders")
    file(MAKE_DIRECTORY "${outDir}")

    _projv_find_shaderc(shaderc)
    _projv_bgfx_shader_include(bgfxShaderInclude)

    set(vertexShaders "")
    set(fragmentShaders "")
    foreach(dir IN LISTS ARG_SHADER_DIRS)
        get_filename_component(dir "${dir}" ABSOLUTE)
        file(GLOB found CONFIGURE_DEPENDS "${dir}/vs_*.sc")
        list(APPEND vertexShaders ${found})
        file(GLOB found CONFIGURE_DEPENDS "${dir}/*.frag")
        list(APPEND fragmentShaders ${found})
    endforeach()
    file(GLOB libraryIncludes CONFIGURE_DEPENDS "${includeDir}/*.sc")

    set(headers "")
    set(includes "")
    set(entries "")
    foreach(profile IN LISTS PROJV_ENGINE_SHADER_PROFILES)
        if(profile STREQUAL "spirv")
            set(platform linux)
            set(rendererType Vulkan)
        elseif(profile STREQUAL "metal")
            set(platform osx)
            set(rendererType Metal)
        else()
            message(FATAL_ERROR "projv_embed_engine_shaders: no renderer type for profile '${profile}'")
        endif()

        foreach(shader IN LISTS vertexShaders fragmentShaders)
            if(shader IN_LIST vertexShaders)
                set(shaderType v)
            else()
                set(shaderType f)
            endif()
            get_filename_component(name "${shader}" NAME_WE)
            get_filename_component(shaderDir "${shader}" DIRECTORY)
            set(symbol "pjv_engine_${name}_${profile}")
            set(header "${outDir}/${name}_${profile}.h")
            add_custom_command(
                OUTPUT "${header}"
                COMMAND "${shaderc}" -f "${shader}" -o "${header}" --type ${shaderType}
                        --platform ${platform} --profile ${profile}
                        --varyingdef "${shaderDir}/varying.def.sc"
                        -i "${bgfxShaderInclude}" -i "${includeDir}"
                        --bin2c ${symbol}
                DEPENDS "${shader}" "${shaderDir}/varying.def.sc" ${libraryIncludes}
                COMMENT "shaderc ${name} (engine, ${profile})"
                VERBATIM
            )
            list(APPEND headers "${header}")
            string(APPEND includes "#include \"${name}_${profile}.h\"\n")
            string(APPEND entries
                "    {\"${name}\", bgfx::RendererType::${rendererType}, ${symbol}, sizeof(${symbol})},\n")
        endforeach()
    endforeach()

    set(source "${outDir}/engine_shader_table.cpp")
    file(CONFIGURE OUTPUT "${source}" CONTENT [[
// Generated by cmake/ProjectVEngineShaders.cmake. The engine's embedded shaders, by name and renderer.
#include <cstdint>
#include "graphics/engine_shaders.h"

@includes@
namespace projv::graphics::detail {
    const EngineShaderEntry engineShaderTable[] = {
@entries@        {nullptr, bgfx::RendererType::Noop, nullptr, 0},
    };
}
]] @ONLY)
    # The generated source is compiled only once every header it includes exists.
    set_source_files_properties("${source}" PROPERTIES OBJECT_DEPENDS "${headers}")
    target_sources(${ARG_TARGET} PRIVATE "${source}" ${headers})
    target_include_directories(${ARG_TARGET} PRIVATE "${outDir}")
endfunction()
