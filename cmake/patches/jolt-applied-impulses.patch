+void ContactConstraintManager::GetAppliedImpulses(Array<AppliedImpulse> &outImpulses) const
+{
+	outImpulses.clear();
+	const ManifoldCache &cache = mCache[mCacheWriteIdx ^ 1];
+
+	Array<const BPKeyValue *> all_bp;
+	cache.GetAllBodyPairsSorted(all_bp);
+	Array<const MKeyValue *> all_m;
+	for (const BPKeyValue *bp_kv : all_bp)
+	{
+		all_m.clear();
+		cache.GetAllManifoldsSorted(bp_kv->GetValue(), all_m);
+		for (const MKeyValue *m_kv : all_m)
+		{
+			const CachedManifold &cm = m_kv->GetValue();
+			if ((cm.mFlags & (uint16)CachedManifold::EFlags::CCDContact) != 0 || cm.mNumContactPoints == 0)
+				continue;
+
+			AppliedImpulse &out = outImpulses.emplace_back();
+			const SubShapeIDPair &key = m_kv->GetKey();
+			out.mBody1ID = key.GetBody1ID();
+			out.mBody2ID = key.GetBody2ID();
+			out.mSubShapeID1 = key.GetSubShapeID1();
+			out.mSubShapeID2 = key.GetSubShapeID2();
+			out.mNormal = Vec3::sLoadFloat3Unsafe(cm.mContactNormal);
+			out.mNormalImpulse = 0.0f;
+			out.mLargestPointImpulse = 0.0f;
+			out.mNumContactPoints = cm.mNumContactPoints;
+			Vec3 weighted = Vec3::sZero();
+			Vec3 sum = Vec3::sZero();
+			for (uint32 i = 0; i < cm.mNumContactPoints; ++i)
+			{
+				const CachedContactPoint &cp = cm.mContactPoints[i];
+				Vec3 p = Vec3::sLoadFloat3Unsafe(cp.mPosition1);
+				weighted += cp.mNonPenetrationLambda * p;
+				sum += p;
+				out.mNormalImpulse += cp.mNonPenetrationLambda;
+				out.mLargestPointImpulse = max(out.mLargestPointImpulse, cp.mNonPenetrationLambda);
+			}
+			out.mPoint1 = out.mNormalImpulse > 0.0f ? weighted / out.mNormalImpulse : sum / float(cm.mNumContactPoints);
+		}
+	}
+}
