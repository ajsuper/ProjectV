 	/// Uses the read collision cache to determine if 2 bodies are in contact.
 	bool						WereBodiesInContact(const BodyID &inBody1ID, const BodyID &inBody2ID) const;
 
+	/// A contact manifold of the last simulation step and the impulses the solver applied to it (ProjectV patch, cmake/patches)
+	struct AppliedImpulse
+	{
+		BodyID					mBody1ID;
+		BodyID					mBody2ID;
+		SubShapeID				mSubShapeID1;
+		SubShapeID				mSubShapeID2;
+		Vec3					mNormal;							///< Contact normal, in the center of mass space of body 2
+		Vec3					mPoint1;							///< Where the impulse acted (its points weighted by their impulse), in the center of mass space of body 1
+		float					mNormalImpulse;						///< Total impulse along the normal (N s), summed over the contact points
+		float					mLargestPointImpulse;				///< The largest of the contact points' impulses (N s)
+		uint					mNumContactPoints;
+	};
+
+	/// Get the impulses applied during the last simulation step, one per contact manifold, ordered by body pair and then sub shape pair (deterministic).
+	/// Only valid between simulation steps.
+	void						GetAppliedImpulses(Array<AppliedImpulse> &outImpulses) const;
+
 	/// Get the number of contact constraints that were found
 	uint32						GetNumConstraints() const											{ return min<uint32>(uint32(mNumConstraintsAndNextConstraintOffset.load(memory_order_relaxed)), mMaxConstraints); }
 
